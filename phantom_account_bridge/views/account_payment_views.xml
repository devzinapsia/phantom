<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.phantom.account.bridge</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_phantom_receipt" type="object" class="oe_stat_button"
                    icon="fa-exchange" invisible="not phantom_receipt_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Phantom</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
