<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.phantom.account.bridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="phantom_connector.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='phantom_enabled_setting']/div[hasclass('content-group')]"
                position="inside">
                <div class="row mt8">
                    <label for="phantom_sales_journal_id" class="col-lg-6 o_light_label"/>
                    <field name="phantom_sales_journal_id" options="{'no_create': True}"/>
                </div>
                <div class="row mt8">
                    <label for="phantom_receipt_journal_id" class="col-lg-6 o_light_label"/>
                    <field name="phantom_receipt_journal_id" options="{'no_create': True}"/>
                </div>
                <div class="row mt8">
                    <label for="phantom_default_product_id" class="col-lg-6 o_light_label"/>
                    <field name="phantom_default_product_id" options="{'no_create': True}"/>
                </div>
                <div class="row mt8">
                    <label for="phantom_analytic_account_id" class="col-lg-6 o_light_label"/>
                    <field name="phantom_analytic_account_id" options="{'no_create': True}"/>
                </div>
                <div class="row mt8">
                    <label for="phantom_classification_id" class="col-lg-6 o_light_label"/>
                    <field name="phantom_classification_id" options="{'no_create': True}"/>
                </div>
                <div class="row mt8" invisible="phantom_processing_mode != 'automatic'">
                    <label for="phantom_create_hour" class="col-lg-6 o_light_label"/>
                    <field name="phantom_create_hour" widget="float_time"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
