<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.phantom.account.bridge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_phantom_invoice" type="object" class="oe_stat_button"
                    icon="fa-exchange" invisible="not phantom_invoice_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Phantom</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
