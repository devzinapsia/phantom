<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="phantom_settings_wizard_form_view" model="ir.ui.view">
        <field name="name">phantom.settings.wizard.form.inherit.phantom.account.bridge</field>
        <field name="model">phantom.settings.wizard</field>
        <field name="inherit_id" ref="phantom_connector.phantom_settings_wizard_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='schedule']" position="after">
                <group string="Documents" name="documents">
                    <field name="phantom_sales_journal_id" options="{'no_create': True}"/>
                    <field name="phantom_receipt_journal_id" options="{'no_create': True}"/>
                    <field name="phantom_default_product_id" options="{'no_create': True}"/>
                    <field name="phantom_analytic_account_id" options="{'no_create': True}"/>
                    <field name="phantom_classification_id" options="{'no_create': True}"/>
                    <field name="phantom_create_hour" widget="float_time"
                        invisible="phantom_processing_mode != 'automatic'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
