<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="phantom_connector.PhantomDashboard" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='onImportNowClick']" position="after">
            <button type="button" class="btn btn-secondary" t-on-click="onProcessNowClick" t-att-disabled="state.processing">
                <t t-esc="labels.processNow"/>
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o_phantom_dashboard')]/div[hasclass('row')][1]" position="before">
            <div t-if="state.progress" class="progress mb-3" style="height: 20px;">
                <!-- Odoo 19's dark theme sets .progress-bar's own color
                     with !important (confirmed live: an inline color
                     without !important is silently overridden, and the
                     "text-white" utility class never wins either since it
                     has the same specificity and loses on source order).
                     Only an inline !important beats it. -->
                <div class="progress-bar" role="progressbar"
                    t-attf-style="width: {{state.progress.percent}}%; color: #fff !important;"
                    t-esc="state.progress.done + ' / ' + state.progress.total"/>
            </div>
        </xpath>
    </t>

</templates>
