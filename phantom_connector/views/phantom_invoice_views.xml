<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="phantom_invoice_list_view" model="ir.ui.view">
        <field name="name">phantom.invoice.list</field>
        <field name="model">phantom.invoice</field>
        <field name="arch" type="xml">
            <list string="Phantom Invoices" create="0">
                <field name="invoice_date"/>
                <field name="doc_type"/>
                <field name="comp_letter"/>
                <field name="point_of_sale"/>
                <field name="comp_number"/>
                <field name="partner_name"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_code"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="transaction_date" optional="hide"/>
                <field name="phantom_idt" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'"
                    decoration-info="state == 'pending'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="phantom_invoice_form_view" model="ir.ui.view">
        <field name="name">phantom.invoice.form</field>
        <field name="model">phantom.invoice</field>
        <field name="arch" type="xml">
            <form string="Phantom Invoice" create="0" edit="0">
                <sheet>
                    <widget name="web_ribbon" text="Phantom" bg_color="text-bg-info"/>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer">
                            <field name="partner_id" string="Customer" invisible="not partner_id"
                                context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="partner_name" string="Customer" invisible="partner_id"/>
                            <field name="address" invisible="partner_id"/>
                            <field name="city" invisible="partner_id"/>
                            <field name="customer_doc_type" invisible="partner_id"/>
                            <field name="customer_document" invisible="partner_id"/>
                            <field name="phantom_customer_id"/>
                        </group>
                        <group name="voucher">
                            <field name="invoice_date"/>
                            <field name="due_date_1" string="Due date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="doc_type"/>
                            <field name="state"/>
                            <field name="phantom_idt"/>
                            <field name="transaction_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="lines">
                            <field name="line_ids" create="0" delete="0" editable="false">
                                <list>
                                    <field name="article_code"/>
                                    <field name="description"/>
                                    <field name="amount_untaxed" string="Net"/>
                                    <field name="tax_percent" string="Tax %"/>
                                    <field name="amount_total" string="Total" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="currency_code"/>
                                <field name="exchange_rate"/>
                                <field name="amount_untaxed" string="Subtotal"/>
                                <field name="amount_tax" string="Tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Detail" name="detail">
                            <field name="detail_raw" nolabel="1"/>
                        </page>
                        <page string="Other information" name="other">
                            <group>
                                <group name="dues">
                                    <field name="due_date_2"/>
                                    <field name="associated_receipt_number"/>
                                    <field name="branch_id_phantom"/>
                                </group>
                            </group>
                        </page>
                        <page string="Error" name="error" invisible="state != 'error'">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="phantom_invoice_search_view" model="ir.ui.view">
        <field name="name">phantom.invoice.search</field>
        <field name="model">phantom.invoice</field>
        <field name="arch" type="xml">
            <search string="Phantom Invoices">
                <field name="comp_number"/>
                <field name="partner_name"/>
                <field name="partner_id"/>
                <field name="phantom_idt"/>
                <field name="company_id"/>
                <filter string="Voucher date" name="invoice_date" date="invoice_date"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <!-- Group By -->
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="phantom_invoice_action" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">phantom.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Phantom invoices yet
            </p>
            <p>
                Invoices imported from Phantom show up here.
            </p>
        </field>
    </record>
</odoo>
