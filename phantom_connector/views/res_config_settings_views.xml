<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.phantom.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <div id="phantom_connector">
                    <block title="Phantom integration" name="phantom_setting_container">
                        <setting id="phantom_enabled_setting" string="Phantom integration"
                            help="Import invoices and receipts from the Phantom billing/collections system">
                            <field name="phantom_enabled"/>
                            <div class="content-group" invisible="not phantom_enabled">
                                <div class="row mt8">
                                    <label for="phantom_url" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_url" placeholder="http://IPPHANTOM/Includes/CRM/API_CRM.php"/>
                                </div>
                                <div class="row mt8">
                                    <label for="phantom_user" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_user"/>
                                </div>
                                <div class="row mt8" groups="base.group_system">
                                    <label for="phantom_password" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_password" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="phantom_processing_mode" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_processing_mode"/>
                                </div>
                                <div class="row mt8" invisible="phantom_processing_mode != 'automatic'">
                                    <label for="phantom_timezone" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_timezone"/>
                                </div>
                                <div class="row mt8" invisible="phantom_processing_mode != 'automatic'">
                                    <label for="phantom_read_hour" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_read_hour" widget="float_time"/>
                                </div>
                                <div class="row mt8">
                                    <label for="phantom_sweep_window_days" class="col-lg-6 o_light_label"/>
                                    <field name="phantom_sweep_window_days"/>
                                </div>
                                <div class="mt16">
                                    <button name="%(phantom_connector.phantom_import_wizard_action)d"
                                        type="action" string="Import now" class="btn-secondary"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
