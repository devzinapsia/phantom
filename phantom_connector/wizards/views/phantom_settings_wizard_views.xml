<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="phantom_settings_wizard_form_view" model="ir.ui.view">
        <field name="name">phantom.settings.wizard.form</field>
        <field name="model">phantom.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Phantom Settings" create="false">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="phantom_enabled"/>
                    </group>
                    <group invisible="not phantom_enabled">
                        <group string="Connection" name="connection">
                            <field name="phantom_url" placeholder="http://IPPHANTOM/Includes/CRM/API_CRM.php"/>
                            <field name="phantom_user"/>
                            <field name="phantom_password" password="True"/>
                        </group>
                        <group string="Schedule" name="schedule">
                            <field name="phantom_processing_mode"/>
                            <field name="phantom_timezone" invisible="phantom_processing_mode != 'automatic'"/>
                            <field name="phantom_read_hour" widget="float_time"
                                invisible="phantom_processing_mode != 'automatic'"/>
                            <field name="phantom_sweep_window_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="phantom_settings_wizard_action" model="ir.actions.act_window">
        <field name="name">Phantom Settings</field>
        <field name="res_model">phantom.settings.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
